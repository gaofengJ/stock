{
  "name": "stock",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.x",
    "pnpm": "9.x"
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:front": "cd apps/front && pnpm run dev",
    "dev:blog": "cd apps/blog && pnpm run dev",
    "dev:back": "cd apps/back && pnpm run start:dev",
    "build:front": "cd apps/front && pnpm run build",
    "build:blog": "cd apps/blog && pnpm run build",
    "build:back": "cd apps/back && pnpm run build",
    "start:back:dev": "cd apps/back && pnpm run start:dev",
    "start:back:debug": "cd apps/back && pnpm run start:debug",
    "start:back:prod": "cd apps/back && pnpm run start:prod",
    "prepare": "husky install",
    "commit": "git-cz"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "commitizen": "^4.3.0",
    "commitlint": "^19.3.0",
    "commitlint-config-cz": "^0.13.3",
    "cz-customizable": "^7.0.0",
    "husky": "8",
    "lint-staged": "13"
  },
  "lint-staged": {
    "apps/front/**/*.{js,jsx,ts,tsx}": [
      "pnpm -C apps/front run lint"
    ],
    "apps/back/**/*.{js,jsx,ts,tsx}": [
      "pnpm -C apps/back run lint"
    ]
  },
  "pnpm": {
    "overrides": {
      "multer": "2.5.0",
      "fastify": "5.12.7",
      "proxy-addr": "2.0.8",
      "postcss@8": "8.5.31",
      "@babel/runtime@7": "7.29.10",
      "cross-spawn@7": "7.0.6",
      "minimatch@9": "9.0.9",
      "brace-expansion@2": "2.1.7",
      "ajv@8": "8.20.0",
      "picomatch@2": "2.3.2",
      "diff@4": "4.0.4",
      "immutable@4": "4.3.9",
      "nanoid@3": "3.3.20",
      "moment@2": "2.31.0",
      "js-yaml@5": "5.5.0",
      "source-map-js@1": "1.2.2",
      "use-sync-external-store@1": "1.7.0",
      "webpack@5": "5.112.2"
    }
  }
}
