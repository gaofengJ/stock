FROM node:18-alpine AS builder

RUN npm install -g pnpm@9.15.9

WORKDIR /usr/src/app

# 依赖文件单独复制，避免业务代码变更导致依赖缓存失效。
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/back/package.json ./apps/back/package.json
RUN pnpm install --filter back --frozen-lockfile

COPY apps/back ./apps/back
RUN pnpm --filter back build

FROM node:18-alpine AS production

RUN npm install -g pnpm@9.15.9

WORKDIR /usr/src/app

# 运行镜像只安装后端生产依赖。
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/back/package.json ./apps/back/package.json
RUN pnpm install --filter back --prod --frozen-lockfile --ignore-scripts

COPY --from=builder /usr/src/app/apps/back/dist ./apps/back/dist
COPY --from=builder /usr/src/app/apps/back/public ./apps/back/public
COPY apps/back/.env.production ./apps/back/.env.production

WORKDIR /usr/src/app/apps/back
ENV NODE_ENV=production

EXPOSE 3000

CMD ["node", "dist/main"]
