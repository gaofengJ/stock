{
  "name": "blog",
  "version": "1.0.0",
  "description": "木风同学的股票博客，记录股票市场那些事",
  "main": "index.js",
  "scripts": {
    "import:aizaibingchuan": "node ./scripts/import-aizaibingchuan.mjs",
    "gen-config": "node ./scripts/generate-config",
    "import:aizaibingchuan-pdf": "python3 ./scripts/import-aizaibingchuan-pdf.py",
    "optimize:aizaibingchuan-images": "node ./scripts/optimize-aizaibingchuan-images.mjs",
    "dedupe:aizaibingchuan-images": "node ./scripts/dedupe-aizaibingchuan-images.mjs",
    "prepare:pagefind": "pnpm run build && node ./scripts/copy-pagefind-for-dev.mjs",
    "dev": "pnpm run gen-config && vitepress dev docs --port 8082",
    "build": "pnpm run gen-config && vitepress build docs && pagefind --site docs/.vitepress/dist --root-selector .vp-doc",
    "preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaofengJ/stock.git"
  },
  "keywords": [],
  "author": "mufeng",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gaofengJ/stock/apps/blog/issues"
  },
  "homepage": "https://github.com/gaofengJ/stock/apps/blog#readme",
  "devDependencies": {
    "eslint": "7",
    "eslint-config-airbnb": "19",
    "pagefind": "1.5.2",
    "sharp": "^0.33.4",
    "vitepress": "^1.1.4"
  }
}
