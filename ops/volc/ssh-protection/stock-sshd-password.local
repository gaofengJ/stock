# The distro default sshd filter also counts preauth disconnects.
# Use only our password-failure jail so CI transport errors cannot trigger a ban.
[sshd]
enabled = false

[stock-sshd-password]
enabled = true
filter = stock-sshd-password
backend = systemd
port = 22
usedns = no
maxretry = 8
findtime = 10m
bantime = 15m
banaction = nftables-multiport
