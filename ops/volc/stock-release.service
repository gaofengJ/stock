[Unit]
Description=Apply a queued verified stock application release
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/etc/stock/production.enabled
ConditionPathExists=/srv/stock/state/cd.enabled

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/stock/deploy/release_worker.py
TimeoutStartSec=30min
UMask=0077
Nice=5
