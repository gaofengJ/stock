+        finally { setBusy(false); }
+      }}>刷新状态</Button>}>
+        <div className="personal-ai-stack"><Typography.Text>{metadata ? `已登录 ${metadata.plan.toUpperCase()} 订阅` : '订阅状态尚未查询'}</Typography.Text><Typography.Text type="secondary">仅刷新登录与额度信息，不发起分析，不购买 credits。</Typography.Text></div>
