+      <div className="personal-ai-metrics">
+        <div className="personal-ai-metric"><span>今日分析次数</span><strong>{state ? `${state.today.calls} / ${state.limits.dailyCalls}` : '—'}</strong></div>
+        <div className="personal-ai-metric"><span>今日 Token 预算占用</span><strong>{state?.today.tokens.toLocaleString() ?? '—'}</strong><span>每日准入预算 {state?.limits.dailyTokens.toLocaleString() ?? '200,000'}</span></div>
+        <div className="personal-ai-metric"><span>订阅窗口剩余额度</span><strong>{remaining}</strong><span>{metadata ? '最近一次查询结果' : '点击下方刷新订阅状态'}</span></div>
+      </div>
+      <Card size="small" title="默认模型">
+        <div className="personal-ai-stack">
+          <ModelControls value={choice} onChange={value => { setChoice(value); setNotice(''); }} metadata={metadata} />
+          <Typography.Text type="secondary">初始默认为 GPT-6.1 Sol / High。设置保存在当前浏览器，仅用于你的账号；每次分析仍可单独选择。</Typography.Text>
+          <Space wrap><Button type="primary" disabled={!supportsChoice(metadata, choice)} onClick={() => {
