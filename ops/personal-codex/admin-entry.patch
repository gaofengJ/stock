diff --git a/apps/front/src/app/admin/ai/page.tsx b/apps/front/src/app/admin/ai/page.tsx
index e69de29b..e47b7edb 100644
--- /dev/null
+++ b/apps/front/src/app/admin/ai/page.tsx
@@ -0,0 +1,57 @@
+'use client';
+
+import { useEffect, useRef, useState } from 'react';
+import { Alert, Button, Space, Typography } from 'antd';
+import { useAccount } from '@/auth/Boundary';
+import { isPersonalAiOwner } from '@/auth/client';
+
+export default function PersonalAiPage() {
+  const { user } = useAccount();
+  const frame = useRef<HTMLIFrameElement>(null);
+  const [attempt, setAttempt] = useState(0);
+  const [status, setStatus] = useState('loading');
+  const [height, setHeight] = useState(1400);
+  const permitted = isPersonalAiOwner(user);
+
+  useEffect(() => {
+    if (!permitted) return undefined;
+    setStatus('loading');
+    const timeout = window.setTimeout(() => setStatus((current) => (current === 'ready' ? current : 'error')), 20000);
+    const receive = (event: MessageEvent) => {
+      if (event.origin !== window.location.origin || event.source !== frame.current?.contentWindow) return;
+      if (event.data?.type !== 'personal-ai-view') return;
+      if (event.data.status === 'ready' || event.data.status === 'error') {
+        window.clearTimeout(timeout);
+        setStatus(event.data.status);
+      }
+      if (Number.isFinite(event.data.height)) setHeight(Math.min(12000, Math.max(600, event.data.height)));
+    };
+    window.addEventListener('message', receive);
+    return () => { window.clearTimeout(timeout); window.removeEventListener('message', receive); };
+  }, [permitted, attempt]);
+
+  if (!permitted) return <Alert type="error" message="此控制台仅限绑定的本人管理员使用。" />;
+  return (
+    <section>
+      <Typography.Title level={3}>个人 AI 控制台</Typography.Title>
+      <Typography.Paragraph type="secondary">沿用网站登录，仅你本人可用。打开页面、选择模型和新建会话不会调用模型。</Typography.Paragraph>
+      {status !== 'ready' && (
+        <Alert
+          style={{ marginBottom: 16 }}
+          type={status === 'error' ? 'warning' : 'info'}
+          message={status === 'error' ? '控制台尚未就绪，请重试；如登录失效，请重新登录网站。' : '正在加载个人控制台…'}
+          action={status === 'error' ? <Button size="small" onClick={() => setAttempt((value) => value + 1)}>重新加载</Button> : undefined}
+        />
+      )}
+      <iframe
+        key={attempt}
+        ref={frame}
+        src="/personal-ai/?embedded=1"
+        title="个人 AI 分析与对话"
+        referrerPolicy="no-referrer"
+        style={{ display: 'block', width: '100%', height, border: 0, borderRadius: 12 }}
+      />
+      <Space style={{ marginTop: 12 }}><Typography.Text type="secondary">仅点击“开始分析”才会提交任务。</Typography.Text></Space>
+    </section>
+  );
+}
